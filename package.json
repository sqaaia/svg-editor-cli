{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1: an object-oriented SVG command-line editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "npm run build --silent && node dist/Main.js",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
